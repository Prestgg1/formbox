  "peerDependencies": {
    "solid-js": ">=1.8.0",
    "@sinclair/typebox": ">=0.32.0"
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.52",
    "@types/bun": "^1.4.2",
    "solid-js": "^1.9.15",
