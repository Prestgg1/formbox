{
  "name": "@prestgg/formbox",
  "version": "0.1.4",
  "description": "Minimal SolidJS form library with native TypeBox validation",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prestgg1/formbox.git"
  },
  "bugs": {
    "url": "https://github.com/Prestgg1/formbox/issues"
  },
  "homepage": "https://github.com/Prestgg1/formbox#readme",
  "scripts": {
